 SHA1Init(SHA1_CTX *ctx)
 {
-	const struct ccdigest_info *di = g_crypto_funcs->ccsha1_di;
+	const struct ccdigest_info *di = FUXI_CRYPTO->ccsha1_di;
 	ccdigest_di_decl(di, di_ctx);
 
-	g_crypto_funcs->ccdigest_init_fn(di, di_ctx);
+	FUXI_CRYPTO->ccdigest_init_fn(di, di_ctx);
 
 	DiToSHA1(di, di_ctx, ctx);
 }
@@ -51,18 +51,18 @@ SHA1Init(SHA1_CTX *ctx)
 void
 SHA1Update(SHA1_CTX *ctx, const void *data, size_t len)
 {
-	const struct ccdigest_info *di = g_crypto_funcs->ccsha1_di;
+	const struct ccdigest_info *di = FUXI_CRYPTO->ccsha1_di;
 	ccdigest_di_decl(di, di_ctx);
 
 	SHA1ToDi(di, ctx, di_ctx);
-	g_crypto_funcs->ccdigest_update_fn(di, di_ctx, len, data);
+	FUXI_CRYPTO->ccdigest_update_fn(di, di_ctx, len, data);
 	DiToSHA1(di, di_ctx, ctx);
 }
 
 void
 SHA1Final(void *digest, SHA1_CTX *ctx)
 {
-	const struct ccdigest_info *di = g_crypto_funcs->ccsha1_di;
+	const struct ccdigest_info *di = FUXI_CRYPTO->ccsha1_di;
 	ccdigest_di_decl(di, di_ctx);
 
 	SHA1ToDi(di, ctx, di_ctx);
@@ -86,6 +86,34 @@ SHA1Final_r(SHA1_CTX *context, void *digest)
 #include <libkern/OSAtomic.h>
 #include <sys/systm.h>
 
+/*
+ * Fork: the FIPS POST runs before the KPI table is registered, and it digests through
+ * these wrappers. Fall back to corecrypto's own entry points, which are linked into this
+ * kernel, so the POST sees real digests instead of a NULL table.
+ */
+#if defined(XNU_SOURCE_CORECRYPTO14)
+#include <corecrypto/ccsha1.h>
+#include <corecrypto/ccsha2.h>
+extern const struct ccdigest_info *ccsha384_di(void);
+
+static const struct crypto_functions fuxi_direct_crypto = {
+	.ccsha1_di          = ccsha1_di,
+	.ccsha256_di        = ccsha256_di,
+	.ccsha384_di        = ccsha384_di,
+	.ccsha512_di        = ccsha512_di,
+	.ccdigest_init_fn   = ccdigest_init,
+	.ccdigest_update_fn = ccdigest_update,
+	.ccdigest_final_fn  = ccdigest_final,
+	.ccdigest_fn        = ccdigest,
+};
+
+#define FUXI_CRYPTO \
+	(g_crypto_funcs ? g_crypto_funcs : (crypto_functions_t)&fuxi_direct_crypto)
+#else
+#define FUXI_CRYPTO g_crypto_funcs
+#endif
+
+
 typedef kern_return_t (*InKernelPerformSHA1Func)(void *ref, const void *data, size_t dataLen, u_int32_t *inHash, u_int32_t options, u_int32_t *outHash, Boolean usePhysicalAddress);
 void sha1_hardware_hook(Boolean option, InKernelPerformSHA1Func func, void *ref);
 static void *SHA1Ref;
