diff --git a/osfmk/prng/prng_random.c b/osfmk/prng/prng_random.c
index c52f0ab..4f0c3a5 100644
--- a/osfmk/prng/prng_random.c
+++ b/osfmk/prng/prng_random.c
@@ -264,6 +264,15 @@ void
 register_and_init_prng(struct cckprng_ctx *ctx, const struct cckprng_funcs *funcs)
 {
 	assert(cpu_number() == master_cpu);
+	/*
+	 * Fork: this kernel can reach the PRNG initialisation twice, because the bring-up
+	 * bootstrap starts a second provider next to the one the platform already ran. The
+	 * first call has already produced a working generator, so ignore the repeat instead
+	 * of asserting.
+	 */
+	if (prng_ready) {
+		return;
+	}
 	assert(!prng_ready);
 
 	entropy_init();
